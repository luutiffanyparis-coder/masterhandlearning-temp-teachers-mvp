:root {
  --bg: #f4f7fb;
  --card: #ffffff;
  --card-alt: #eef5ff;
  --primary: #0c5ad7;
  --primary-dark: #093f96;
  --secondary: #e8f2ff;
  --text: #112033;
  --muted: #59708c;
  --border: #dfeaf8;
  --success: #0f9f6e;
  --warning: #f29f05;
  font-family: 'Inter', sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button,
input,
select,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.app-shell {
  max-width: 1320px;
  margin: 0 auto;
  padding: 32px 24px 56px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.topbar h1 {
  margin: 6px 0 0;
  font-size: clamp(1.9rem, 2.5vw, 2.7rem);
}

.eyebrow {
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
}

.status-pill {
  background: var(--secondary);
  color: var(--primary-dark);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 700;
}

.nav-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  border-bottom: 2px solid var(--border);
  padding-bottom: 16px;
  margin-bottom: 20px;
}

.nav-tab {
  border: 1px solid var(--border);
  background: white;
  color: var(--text);
  border-radius: 999px;
  padding: 10px 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-tab:hover,
.nav-tab.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

.panel-grid {
  display: grid;
  gap: 20px;
}

.two-column {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.panel {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 10px 26px rgba(17, 32, 51, 0.04);
}

.panel h2 {
  margin-top: 0;
  font-size: 1.6rem;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 600;
  color: var(--text);
}

input,
select,
textarea {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  background: #fbfdff;
  color: var(--text);
}

textarea {
  resize: vertical;
}

select[multiple] {
  min-height: 100px;
}

.primary-button,
.secondary-button {
  border: none;
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.primary-button {
  background: var(--primary);
  color: white;
}

.primary-button:hover {
  background: var(--primary-dark);
}

.secondary-button {
  background: var(--secondary);
  color: var(--primary-dark);
}

.mini-card,
.match-card,
.approval-card,
.teacher-card {
  background: var(--card-alt);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 16px;
}

.mini-card h3 {
  margin-top: 0;
}

.mini-card ul,
.match-card ul,
.approval-card ul {
  margin: 0;
  padding-left: 18px;
  line-height: 1.8;
}

.teacher-grid,
.results-list,
.approval-list {
  display: grid;
  gap: 18px;
}

.teacher-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.teacher-card img,
.teacher-head img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 14px;
}

.teacher-text h3,
.teacher-head h3 {
  margin: 0 0 6px;
}

.teacher-text p,
.teacher-head p {
  margin: 0 0 6px;
  color: var(--muted);
}

.match-card {
  background: #f4f9ff;
}

.teacher-head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
}

.teacher-head img {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  margin-bottom: 0;
}

.score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12px 0;
  padding: 10px 12px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0;
}

.chip {
  padding: 6px 10px;
  border-radius: 999px;
  background: white;
  border: 1px solid var(--border);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--primary-dark);
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180px;
  border: 1px dashed var(--border);
  border-radius: 14px;
  background: #f8fbff;
  color: var(--muted);
  font-weight: 600;
}

@media (max-width: 860px) {
  .two-column {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
